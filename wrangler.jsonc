{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mapcrush",
  "main": "worker.js",
  "compatibility_date": "2026-05-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_COORDINATOR",
        "class_name": "SessionCoordinator"
      }
    ]
  },
  "exports": {
    "SessionCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "kv_namespaces": [
    {
      "binding": "KV_BINDING",
      "id": "eaaf7c5fcdad40a5b7c9da2afe4dfb79"
    }
  ]
}
